{
  "name": "@biac/cli",
  "version": "0.2.0",
  "description": "Business intelligence as code: turn Markdown pages and data files into a BI site",
  "keywords": [
    "business-intelligence",
    "bi",
    "dashboard",
    "data-visualization",
    "duckdb",
    "markdown",
    "sql",
    "static-site-generator"
  ],
  "homepage": "https://github.com/dmenezesgabriel/bi-as-code#readme",
  "bugs": {
    "url": "https://github.com/dmenezesgabriel/bi-as-code/issues"
  },
  "license": "Apache-2.0",
  "author": "Gabriel Menezes (https://github.com/dmenezesgabriel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmenezesgabriel/bi-as-code.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "bin": {
    "biac": "bin/biac"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "NOTICE",
    "dist/cli",
    "dist/engine",
    "src/web",
    "!src/web/.storybook",
    "!src/web/node_modules",
    "!src/web/package.json",
    "!**/*.stories.tsx",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.fixture.ts",
    "!**/*.fixture.tsx",
    "!**/*.mdx"
  ],
  "scripts": {
    "dev": "vite --config src/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config src/web/vite.config.ts",
    "preview": "vite preview --config src/web/vite.config.ts",
    "build:cli": "tsc -p tsconfig.build.json",
    "commit": "git-cz",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:web-unit": "vitest --project web-unit",
    "test:integration": "vitest --project integration",
    "test:e2e": "vitest --project e2e",
    "test:e2e:setup": "npx playwright install --with-deps && npx playwright --version",
    "test:e2e-browser": "bash scripts/run-capped.sh e2e-browser playwright test --pass-with-no-tests",
    "test:cucumber": "cucumber-js",
    "test:install": "bash scripts/run-capped.sh install vitest run --config vitest.install.config.ts",
    "test:deploy": "bash scripts/run-capped.sh deploy vitest run --config vitest.deploy.config.ts",
    "example:s3-sso:smoke": "nice -n 10 timeout 15m bash examples/s3-sso/smoke.sh",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "gate": "bash scripts/run-capped.sh gate scripts/gate.sh",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/root.tsbuildinfo && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/web.tsbuildinfo --project src/web/tsconfig.json",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ src/",
    "lint:style": "stylelint 'src/web/src/**/*.css'",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json,mdx}' 'maintainer/**/*.md' 'docs/**/*.md' '*.md'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json,mdx}' 'maintainer/**/*.md' 'docs/**/*.md' '*.md'",
    "knip": "knip",
    "dep:cruise": "depcruise --config .dependency-cruiser.cjs src",
    "jscpd": "jscpd --config .jscpd.json --silent",
    "jscpd:report": "jscpd --config .jscpd.json",
    "fallow:health": "fallow health --css",
    "fallow:score": "fallow health --css --min-score 70",
    "storybook": "storybook dev --config-dir src/web/.storybook --no-open --port 6175",
    "storybook:build": "storybook build --config-dir src/web/.storybook --output-dir dist/storybook",
    "prepare": "husky",
    "prepack": "pnpm build:cli"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-doctor": "0.9.22",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "fallow": "3.40.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "jsdom": "31.0.0",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "storybook": "10.6.6",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@vitejs/plugin-react": "6.2.1",
    "apache-arrow": "17.0.0",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "echarts": "6.1.0",
    "effect": "4.1.2",
    "i18next": "26.7.2",
    "lucide-react": "1.70.0",
    "mdast-util-mdx-jsx": "3.2.1",
    "mdast-util-to-string": "4.0.0",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vfile": "6.0.3",
    "vfile-matter": "5.0.1",
    "vite": "8.3.6",
    "yaml": "2.9.1"
  }
}
