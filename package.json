{
  "name": "bi-as-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "bin": {
    "biac": "bin/biac"
  },
  "scripts": {
    "dev": "vite --config src/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config src/web/vite.config.ts",
    "preview": "vite preview --config src/web/vite.config.ts",
    "build:cli": "tsc -p tsconfig.build.json",
    "commit": "git-cz",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:web-unit": "vitest --project web-unit",
    "test:integration": "vitest --project integration",
    "test:e2e": "vitest --project e2e",
    "test:e2e:setup": "npx playwright install --with-deps && npx playwright --version",
    "test:e2e-browser": "bash scripts/run-capped.sh e2e-browser playwright test --pass-with-no-tests",
    "test:cucumber": "cucumber-js",
    "test:deploy": "bash scripts/run-capped.sh deploy vitest run --config vitest.deploy.config.ts",
    "example:s3-sso:smoke": "nice -n 10 timeout 15m bash examples/s3-sso/smoke.sh",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "gate": "bash scripts/run-capped.sh gate scripts/gate.sh",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/root.tsbuildinfo && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/web.tsbuildinfo --project src/web/tsconfig.json",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ src/",
    "lint:style": "stylelint 'src/web/src/**/*.css'",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}' 'docs/**/*.md' '*.md'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json}' 'docs/**/*.md' '*.md'",
    "knip": "knip",
    "dep:cruise": "depcruise --config .dependency-cruiser.cjs src",
    "jscpd": "jscpd --config .jscpd.json --silent",
    "jscpd:report": "jscpd --config .jscpd.json",
    "fallow:health": "fallow health --css",
    "fallow:score": "fallow health --css --min-score 70",
    "storybook": "storybook dev --config-dir src/web/.storybook --no-open --port 6175",
    "storybook:build": "storybook build --config-dir src/web/.storybook --output-dir dist/storybook",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cucumber/cucumber": "11.3.0",
    "@eslint/js": "10.0.1",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "4.1.8",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.0.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.6.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-doctor": "0.9.14",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "fallow": "3.23.0",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jscpd": "4.0.4",
    "jsdom": "30.0.1",
    "knip": "5.61.3",
    "lint-staged": "15.5.1",
    "mdast-util-mdx-jsx": "3.2.0",
    "mdast-util-to-string": "4.0.0",
    "msw": "2.15.0",
    "prettier": "3.8.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.0",
    "stylelint": "16.18.0",
    "stylelint-config-standard": "38.0.0",
    "tailwindcss": "4.1.8",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vfile-matter": "5.0.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "i18next": "26.5.2",
    "yaml": "2.9.1"
  }
}
