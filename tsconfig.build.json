{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Only legal under noEmit — turned off here so the emitted CLI/engine
    // keep the NodeNext .js specifier convention the flag bypasses.
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/cli/**/*", "src/engine/**/*"],
  "exclude": ["**/*.test.ts", "src/web/**/*"]
}
