# The TLS edge in front of the private bucket, in the place an ALB HTTPS
# listener takes in AWS. oauth2-proxy grants every read before it reaches
# the bucket, and every read goes through the SigV4 signer; Caddy never
# holds a key. The gate follows oauth2-proxy's Caddy integration:
# https://oauth2-proxy.github.io/oauth2-proxy/configuration/integrations/caddy
{
	# The container listens on the ports it publishes. The HTTPS port is in
	# the site address, not `https_port`: Caddy's automatic HTTP→HTTPS
	# redirect leaves out a port equal to `https_port`, so setting that to
	# 8443 would redirect to https://localhost/.
	http_port 8080
	# The local CA lives in the container; trusting it is the host's choice.
	skip_install_trust
}

localhost:8443 {
	tls internal

	# Keycloak shares the app's origin, so the issuer the browser signs in
	# at is the one every token names. Only the realm endpoints and the
	# login page's assets pass; the admin console stays on the network.
	@keycloak path /realms/* /resources/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	# Sign-in, callback and sign-out answer before any session exists.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	handle {
		# forward_auth sorts ahead of `route`, so `{uri}` is still the URL
		# the viewer asked for. It goes back to them escaped and relative,
		# so its query survives and no redirect domain has to be allowed.
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}
			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * /oauth2/sign_in?rd={http.request.uri_escaped}
			}
		}

		# A route runs its directives in the order written; outside one,
		# Caddy would sort the rewrites ahead of forward_auth.
		route {
			# S3's REST API serves no index document, so a route directory is
			# rewritten to the per-route copy `biac build` emits (ADR-0029).
			@directory path */
			rewrite @directory {path}index.html

			# Sibling rewrites are mutually exclusive in Caddy, even inside a
			# route, so the bucket prefix is added in a nested one.
			route {
				rewrite * /biac-site{uri}
				reverse_proxy signer:8080 {
					# A reader without s3:ListBucket gets 403 for a missing key on
					# real S3 and 404 on moto; both are a miss to the viewer.
					@missing status 403 404
					handle_response @missing {
						error 404
					}
				}
			}
		}
	}

	# The build's 404.html is the not-found document, answered with a real
	# 404 as `biac serve` does (ADR-0030).
	# Proxied as-is it would carry the bucket's 200, so the body and headers
	# are copied under the error's status.
	handle_errors 404 {
		rewrite * /biac-site/404.html
		reverse_proxy signer:8080 {
			handle_response {
				copy_response_headers
				copy_response 404
			}
		}
	}
}
