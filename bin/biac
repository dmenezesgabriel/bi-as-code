#!/usr/bin/env node
// biac CLI launcher script: the file package.json's `bin` points to.
// Node 24 type-stripping does not resolve NodeNext-style `.js` → `.ts`
// specifiers, so this shim runs the compiled dist — `pnpm build:cli`
// is mandatory before `biac` can run.
import { main } from "../dist/cli/main.js";

try {
  await main(process.argv.slice(2));
} catch (error) {
  console.error(error instanceof Error ? error.message : String(error));
  process.exit(1);
}
