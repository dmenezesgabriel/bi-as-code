{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreExportsUsedInFile": true,
  // Both vitest configs, so the deploy suite's config and specs are entries.
  "vitest": {
    "config": ["vitest.config.ts", "vitest.deploy.config.ts"]
  },
  "ignore": [
    // Loaded at runtime by the engine's loadBiacConfig via vite's
    // loadConfigFromFile — never statically imported, so knip can't see it.
    "biac.config.ts",
    // Data loaders and the helper modules they import: the engine spawns
    // each `data/<target>.js` as a program — never imported, so knip can't
    // see it (src/engine/data-loader.ts).
    "data/**/*.js",
    "test/fixtures/**",
    "vitest.stryker.config.ts",
    "test/e2e-browser/global-setup.ts",
    "src/cli/main.ts",
    "src/web/src/components/index.ts",
    "src/web/src/features/index.ts",
    "src/web/src/lib/index.ts",
    // Vitest `setupFiles` entry — knip does not descend into the `projects`
    // array in vitest.config.ts, so the reference is invisible to it.
    "src/web/vitest.setup.ts",
    // Imported only by the widget-module entry the build generates at build
    // time (src/cli/commands/build.ts writes it to a temp dir for the
    // library-mode build) — never statically imported, so knip can't see it.
    "src/web/src/features/widget-module/module-runtime.ts"
  ],
  "ignoreDependencies": [
    "minimal",
    "@tailwindcss/vite",
    "tailwindcss",
    "@vitejs/plugin-react",
    "msw",
    // Imported only by src/web/vitest.setup.ts (ignored above).
    "@testing-library/jest-dom"
  ]
}
